# Copy to .env. Never commit .env.

# Database — SQLite default for zero-setup; switch to PostgreSQL for production parity.
DATABASE_URL=sqlite:///./cos.db
# DATABASE_URL=postgresql+psycopg2://cos:cos@localhost:5432/cos

# JWT — MUST be 32+ chars and not match any known placeholder.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# The Settings validator rejects empty, the placeholders listed below, or
# anything under 32 chars; on rejection it mints an ephemeral random secret
# for THIS process and logs CRITICAL. Tokens won't survive restart until
# you set a real value here. The same secret must also be configured on
# any sister service that verifies our tokens.
JWT_SECRET=replace-me-with-output-of-the-python-secrets-command-above
JWT_ALGORITHM=HS256
JWT_LIFETIME_SECONDS=86400

# Password hashing
BCRYPT_ROUNDS=12

# Account lockout (Phase 2 NFR-AU6)
LOCKOUT_THRESHOLD=5
LOCKOUT_DURATION_MINUTES=15

# Stale-pending sweep (Phase 1 FR-D6 / Member B REQ_EC_5)
SWEEP_INTERVAL_SECONDS=300
STALE_THRESHOLD_MINUTES=15

# CORS — list every origin the browser may use. localhost and 127.0.0.1
# are distinct origins as far as the browser is concerned; include both
# variants per port so devs hitting either URL don't see CORS rejections.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001

# Server
HOST=0.0.0.0
PORT=8000
