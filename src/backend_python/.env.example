# Copy to .env. Never commit .env.

# Database — SQLite default for zero-setup; switch to PostgreSQL for production parity.
DATABASE_URL=sqlite:///./cos.db
# DATABASE_URL=postgresql+psycopg2://cos:cos@localhost:5432/cos

# JWT — MUST be 32+ chars. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# This MUST be the same secret used by any other service that verifies our tokens.
JWT_SECRET=change-me-this-must-be-at-least-32-chars-long
JWT_ALGORITHM=HS256
JWT_LIFETIME_SECONDS=86400

# Password hashing
BCRYPT_ROUNDS=12

# Account lockout (Phase 2 NFR-AU6)
LOCKOUT_THRESHOLD=5
LOCKOUT_DURATION_MINUTES=15

# Stale-pending sweep (Phase 1 FR-D6 / Member B REQ_EC_5)
SWEEP_INTERVAL_SECONDS=300
STALE_THRESHOLD_MINUTES=15

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# Server
HOST=0.0.0.0
PORT=8000
